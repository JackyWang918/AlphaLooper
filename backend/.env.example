# Optional network configuration. Default: httpx, direct network.
# uv run --env-file .env uvicorn app.main:app --host 127.0.0.1 --port 18760
ALPHALOOPER_HTTP_TRANSPORT=httpx
# ALPHALOOPER_HTTP_PROXY=http://127.0.0.1:7897
# ALPHALOOPER_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-me
# AI only analyzes abnormal pauses; fill the real key in backend/.env, never Git.
ALPHALOOPER_AI_DIAGNOSTICS_ENABLED=true
ALPHALOOPER_DEEPSEEK_API_KEY=
ALPHALOOPER_DEEPSEEK_MODEL=deepseek-flash
ALPHALOOPER_DEEPSEEK_TIMEOUT_SECONDS=20
# AI uses ALPHALOOPER_HTTP_PROXY when set. No automatic retries or trading tools.
# When httpx is selected, a transient public-market request retries once and
# then tries curl with the same proxy. Set curl explicitly to use only curl.
# Windows TLS compatibility fallback: ALPHALOOPER_HTTP_TRANSPORT=curl
